<Page x:Class="авторизация.PageLogin"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:авторизация"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PageLogin"
      Background="White">
    <Page.Resources>
        <!--  Стиль для всех кнопок -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#CBA6F7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#A68BEA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B084F5"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#9C6DF2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  Стиль для всех текстбоксов -->
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!--  Стиль для поля пароля -->
        <Style TargetType="PasswordBox">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <!--  Стиль для текстовых надписей -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#444"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Добро пожаловать"
                   Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                   FontSize="26"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

        <TextBlock Text="Логин:"
                   Grid.Column="0" Grid.Row="1"
                   FontSize="20"
                   Foreground="Lavender"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

        <TextBox x:Name="tbLogin"
                 Grid.Column="1" Grid.Row="1"
                 Width="200" Height="30"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

        <TextBlock Text="Пароль:"
                   Grid.Column="0" Grid.Row="2"
                   FontSize="20"
                   Foreground="LightBlue"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

        <PasswordBox x:Name="pbPassword"
                     Grid.Column="1" Grid.Row="2"
                     Width="200" Height="30"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"/>

        <Button x:Name="btnLogin"
                Content="Войти"
                Grid.Column="0" Grid.ColumnSpan="2"
                Grid.Row="3"
                Width="120" Height="35"
                Background="Lavender"
                Click="btnLogin_Click"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>
    </Grid>
</Page>
